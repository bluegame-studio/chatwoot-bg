CHATWOOT_URL=http://localhost:3000
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_BOT_TOKEN=copy-agent-bot-access-token-here

# Optional. If filled, the bot verifies X-Chatwoot-Signature.
CHATWOOT_BOT_SECRET=

BOT_PORT=4000
BOT_HOST=127.0.0.1
HANDOFF_AFTER=3
BOT_STATE_FILE=/tmp/chatwoot-simple-agent-bot-state.json

# Optional. The first incoming message in each support round receives this input_select message.
BOT_INTERACTIVE_MESSAGE=你好，我是智能助手。请选择你需要的服务：
BOT_INTERACTIVE_OPTIONS=咨询订单:order,转人工客服:agent
